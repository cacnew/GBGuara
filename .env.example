NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE_PREFIX=nexusdojo_

RESEND_API_KEY=
EMAIL_FROM=
NEXT_PUBLIC_APP_URL=

ASAAS_API_KEY=
# sandbox ou production
ASAAS_ENV=sandbox
# Token configurado manualmente no painel do Asaas ao cadastrar a URL do
# webhook (app/api/webhooks/asaas) - Asaas envia esse valor no header
# asaas-access-token em toda chamada.
ASAAS_WEBHOOK_TOKEN=

CRON_SECRET=

# Conta de aluno usada pelos testes automatizados (tests/integration, e2e).
# Cada dev deve apontar para sua propria conta dedicada (ver docs/TEST_ACCOUNTS.md)
# para evitar conflito entre execucoes paralelas na conta demo compartilhada.
TEST_STUDENT_EMAIL=
